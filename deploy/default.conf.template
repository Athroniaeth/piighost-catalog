# Single origin: nginx serves the Svelte bundle and proxies /api to Litestar. The
# browser only ever sees one host, so no CORS and no API URL baked into the bundle.
# Frontend and API remain two containers, sized independently.
#
# A template, not a plain conf: the nginx entrypoint runs envsubst over
# /etc/nginx/templates at startup to inject ${API_KEY}. NGINX_ENVSUBST_FILTER limits
# the substitution to that one name, so nginx's own $uri/$host survive untouched.
# Keep the protocol seen by the *browser*. Traefik terminates TLS and talks to this
# container in plain HTTP, so $scheme is "http" here: forwarding it would tell the API
# the visitor is not on HTTPS, which breaks Secure cookies and absolute redirects.
# Falls back to $scheme when no proxy sits in front (local `docker compose`).
map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# Pass the chain through untouched when a proxy already set it. The usual
# $proxy_add_x_forwarded_for would append $remote_addr, which real_ip has just
# rewritten to the client address — listing it twice for no reason.
map $http_x_forwarded_for $forwarded_for {
    ""      $remote_addr;
    default $http_x_forwarded_for;
}

# The language a page without one is sent to: French when the browser puts
# French first, English otherwise, a crawler included since it sends none. The
# server-side reading of navigator.language, which is the first entry of this
# header.
map $http_accept_language $preferred_lang {
    default en;
    ~*^fr   fr;
}

# The catalog's former name. Both hostnames reach this container, and the old
# one now only redirects, path and query kept, so a link or a bookmark lands on
# the same page under the new name. piighost 1.x resolves `hub:` references
# with GET /api/v1/refs/... on this host, and urllib follows a 301 on a GET:
# those clients keep working through the redirect. A matching server_name
# rather than an `if ($host ...)`: the main server below stays the default, so
# a request with any other Host (a health check on localhost, Traefik probing
# the port) is served as before.
server {
    listen 8080;
    server_name hub.piighost.dev;

    # Logged on purpose: the access log tells when the old name stops being used.
    return 301 https://catalog.piighost.dev$request_uri;
}

server {
    # 8080 rather than 80: the base image runs unprivileged. default_server so
    # that any Host but the one above, localhost included, is served here.
    listen 8080 default_server;

    # Recover the real client address from the proxy in front, so $remote_addr — and
    # therefore the access log and X-Real-IP — stop showing Traefik's internal IP.
    # Trust is limited to private ranges: X-Forwarded-For is client-controlled and
    # must never be believed when it comes straight from the internet.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    server_name _;

    # A redirect names the path alone. With the default absolute form, nginx
    # would write its own scheme and port, http://...:8080, behind a proxy that
    # terminates TLS on 443.
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Vite hashe le nom de chaque asset, donc le contenu d'une URL ne change jamais.
    location /assets/ {
        include /etc/nginx/security-headers.conf;

        # One header only: adding `expires` would emit a second, duplicate one.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    location /api/ {
        # The API key is added here, server-side, so it never reaches the browser:
        # the bundle holds no secret. proxy_set_header also overwrites any header a
        # client sent, so this value is the only one the API ever sees from us.
        proxy_set_header X-API-Key "${API_KEY}";

        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # The OpenAPI docs, served by Litestar.
    location /schema {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # OpenPanel ingestion, relayed so that it is same-origin.
    #
    # Two things come from this and both matter. The Content-Security-Policy
    # below stays `connect-src 'self'`, with no analytics host punched into it,
    # and a request to /api/op looks like every other request this site makes,
    # so an ad blocker that drops calls to an analytics domain has nothing to
    # recognise. The SDK itself is bundled, so no script is fetched anywhere.
    #
    # The SDK posts to ${OPENPANEL_API_URL}/track, which arrives here as
    # /api/op/track and is rewritten back to /track upstream. resolver is
    # Docker's DNS: with a variable in proxy_pass the host is resolved per
    # request rather than frozen at start-up.
    location /api/op/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $op_host "${OPENPANEL_HOST}";
        rewrite ^/api/op/(.*)$ /$1 break;
        proxy_pass https://$op_host;
        proxy_ssl_server_name on;
        proxy_set_header Host "${OPENPANEL_HOST}";
        # OpenPanel checks the origin against the client's allow list, and the
        # browser sends this site's. Forcing it keeps the check meaningful and
        # the relay honest about who it speaks for.
        proxy_set_header Origin "${SITE_URL}";
    }

    # Generated from the registry rather than kept as static files, so the URL
    # list follows the catalogue instead of drifting behind it. Two exact
    # locations: a crawler asks for these paths and nothing else here.
    location ~ ^/(robots\.txt|sitemap\.xml|llms\.txt)$ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # nginx's mime.types predates ES modules and has no entry for .mjs, so it
    # falls back to application/octet-stream. With X-Content-Type-Options set to
    # nosniff, which it is, a browser refuses to execute the module and the
    # import fails naming the file rather than the reason. Pyodide ships its
    # runtime as .mjs, so this is what lets it load at all.
    #
    # `default_type` rather than a `types` block: a types block in a server
    # replaces the whole inherited table instead of extending it, which leaves
    # index.html itself typeless and turns the site into a download.
    location ~ \.mjs$ {
        include /etc/nginx/security-headers.conf;

        default_type text/javascript;
        try_files $uri =404;
    }

    # The web app manifest: nginx's mime.types has no entry for .webmanifest, so it
    # went out as application/octet-stream. Same `default_type` approach as .mjs
    # above, for the same reason.
    location = /manifest.webmanifest {
        include /etc/nginx/security-headers.conf;

        default_type application/manifest+json;
        try_files $uri =404;
    }

    # Asked for by browsers on their own. Without this it falls through to the SPA
    # fallback below and answers HTML with a 200, where an icon is expected.
    location = /favicon.ico {
        try_files $uri =404;
        access_log off;
    }

    # Every page lives under its language, the scheme the other piighost sites
    # link to. `no-cache` on this HTML, else a browser would keep the old hashed
    # asset names and never see a deployment.
    location ~ ^/(en|fr)(/|$) {
        include /etc/nginx/security-headers.conf;

        # $uri/index.html is the prerendered page for this route, written at
        # build time; /index.html is the application shell for everything else,
        # routed client-side.
        try_files $uri $uri/index.html /index.html;
        add_header Cache-Control "no-cache" always;
    }

    # The files beside the bundle (favicon.svg, theme.js, og.png, pyodide/...)
    # are served as they are. Any other path predates the languages, a link or
    # a bookmark to /r/piighost/generic: it moves under the browser's language,
    # path and query kept. A 302, since the answer depends on who asks.
    location / {
        include /etc/nginx/security-headers.conf;

        try_files $uri @localize;
        add_header Cache-Control "no-cache" always;
    }

    location @localize {
        add_header Vary "Accept-Language" always;
        return 302 /$preferred_lang$request_uri;
    }
}
