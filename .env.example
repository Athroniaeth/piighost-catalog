# Point d'entrée de l'application, lu par la CLI Litestar.
# Requis : l'autodiscovery ne cherche que app.py/application.py à la racine.
LITESTAR_APP=backend.app:app

# Clé attendue par le guard de /api/hello. nginx l'injecte côté serveur en
# production, le proxy Vite en développement : elle n'entre jamais dans le bundle.
# Requise — sans elle, la route refuse tout et `docker compose up` s'arrête.
API_KEY=dev-only-change-me

# URL du backend, lue par litestar-vite-plugin pour son diagnostic de dev.
# Sans elle, le dev server affiche un avertissement « backend absent » trompeur.
APP_URL=http://127.0.0.1:8000

# Sert la documentation OpenAPI sur /schema (Swagger, Redoc, openapi.json).
# Lu par backend/__init__.py. Défaut : true — désactivé dans compose.prod.yml,
# car /schema publie l'inventaire complet des routes.
#ENABLE_DOCS=false

# Nombre de workers Granian, lu par la CLI. C'est le levier de dimensionnement
# vertical de l'API. Défaut : 1
#WEB_CONCURRENCY=4

# Port du dev server Vite. Lu par frontend/vite.config.ts. Défaut : 5173
#VITE_PORT=5173

# Cible du proxy /api du dev server Vite, si l'API n'écoute pas sur le port
# habituel. Lu par frontend/vite.config.ts. Défaut : http://127.0.0.1:8000
#API_URL=http://127.0.0.1:8000

# Répertoire du registre du catalogue, lu au démarrage par backend/hub. Défaut : le
# dossier `registry/` du dépôt. L'image Docker le fixe à /app/registry. Pointez-le
# ailleurs pour servir un miroir interne sans reconstruire l'image.
#HUB_REGISTRY_DIR=./registry

# Dépôt et branche visés par le lien de pull request que la page « Contribuer »
# génère. Aucun jeton n'est stocké ici : le visiteur est déjà connecté à GitHub,
# et le fork comme la branche sont l'affaire de GitHub.
#HUB_REGISTRY_REPO=Athroniaeth/piighost-catalog
#HUB_REGISTRY_BRANCH=main

# --- Analytics OpenPanel auto-hébergé ---
# Rien n'est envoyé tant que ces variables sont vides : c'est le défaut en
# développement et pour quiconque héberge le catalogue lui-même.
#
# Deux clients à créer dans le dashboard, parce que deux choses différentes
# parlent. Le site est un navigateur : il lui faut un client dont l'id est
# public, inliné dans le bundle, sans secret. L'API répond aussi à la
# bibliothèque piighost, qui résout une référence `catalog:` (dans un fichier de
# pipeline ou par `RegexDetector.from_catalog`) sans navigateur : les
# événements partent alors du serveur, ce que l'API track exige d'authentifier
# avec un client d'écriture, donc un id ET un secret.

# Le client navigateur. Inliné au build par Vite, donc il est passé en build arg
# dans compose.yml. Public par construction : il ne permet que d'écrire dans le
# projet qu'il nomme.
#VITE_OPENPANEL_CLIENT_ID=

# Où le navigateur poste ses événements. Défaut : /api/op, même origine, relayé
# par nginx. Le laisser ainsi garde la CSP en `connect-src 'self'` et rend les
# requêtes indiscernables du reste du site pour un bloqueur de publicité.
#VITE_OPENPANEL_API_URL=/api/op

# Hôte vers lequel nginx relaie /api/op, et origine qu'il présente à la liste
# blanche d'OpenPanel. Défaut : opapi.athroniaeth.cloud et localhost.
#OPENPANEL_HOST=opapi.athroniaeth.cloud
#SITE_URL=https://catalog.piighost.dev

# Le client serveur, pour les appels que le navigateur ne peut pas rapporter.
# Les trois ou aucun. Le secret ne quitte jamais l'API.
#OPENPANEL_API_URL=https://opapi.athroniaeth.cloud
#OPENPANEL_CLIENT_ID=
#OPENPANEL_CLIENT_SECRET=
