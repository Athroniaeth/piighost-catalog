{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b --noEmit && node scripts/prerender.mjs",
    "preview": "vite preview",
    "serve": "vite preview",
    "watch": "pnpm run serve",
    "update": "pnpm update",
    "generate-types": "openapi-ts --file openapi-ts.config.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pyodide-assets": "node scripts/pyodide-assets.mjs",
    "predev": "node scripts/pyodide-assets.mjs",
    "prebuild": "node scripts/pyodide-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/svelte": "^1.51.0",
    "@openpanel/web": "^1.4.1",
    "@piighost/ui": "file:vendor/piighost-ui-0.2.4.tgz",
    "pyodide": "^314.0.7",
    "svelte": "5.57.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "litestar-vite-plugin": "0.31.0",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "smol-toml": "^1.8.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  }
}
